# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz_shop
DB_USER=root
DB_PASSWORD=

# Site Configuration
SITE_NAME=فروشگاه آنلاین
SITE_URL=http://localhost
SITE_ADMIN_EMAIL=admin@example.com

# Security
SECURE_KEY=your_secure_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here

# Payment Gateway (Example: ZarinPal)
PAYMENT_GATEWAY=zarinpal
PAYMENT_MERCHANT_ID=your_merchant_id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@quiz-shop.com
SMTP_FROM_NAME=فروشگاه آنلاین

# SMS Configuration (Optional)
SMS_PROVIDER=kavenegar
SMS_API_KEY=your_sms_api_key

# Session
SESSION_TIMEOUT=3600
SESSION_PATH=/tmp/

# Environment
APP_ENV=development
DEBUG=true

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=jpg,jpeg,png,gif,pdf,mp4,webp

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_CONTACT=2
